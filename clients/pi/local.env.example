# Copy to local.env (gitignored). Do not commit real LAN addresses.
# CRATE_HOST=desktop.local
# CRATE_PORT=8746
# Optional sounddevice ids from --list-devices:
# CRATE_INPUT=1
# CRATE_OUTPUT=0
# Or match by name (used when the matching id above is unset):
# CRATE_INPUT_NAME=USB PnP
# CRATE_OUTPUT_NAME=default
# Bluetooth/JBL: install pipewire-alsa, keep mic on USB PnP, set output to default/pipewire.
# Still size: 0 = full native (default). Adaptive may step down if sends are slow.
# Porch thermal: cap stills (1280 is plenty for CLIP). 0 = native ~1080p.
# CRATE_MAX_EDGE=1280
# CRATE_STILL_SLOW_MS=800
# USB audio watchdog (clients/pi/usb_audio_watch.sh) — leave off unless night-of auto-reboot desired.
# CRATE_USB_ALLOW_REBOOT=0
# CRATE_USB_COOLDOWN_SEC=120
# CRATE_USB_MAX_REBOOTS_PER_HOUR=2
